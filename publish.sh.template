#!/bin/bash
# Copy to publish.sh and fill in your local paths.
# Usage: bash publish.sh 0.1.0 YOUR_THUNDERSTORE_TOKEN
set -e

VERSION=$1
TOKEN=$2

if [ -z "$VERSION" ] || [ -z "$TOKEN" ]; then
    echo "Usage: bash publish.sh <version> <thunderstore_token>"
    exit 1
fi

DOTNET="/path/to/dotnet.exe"
TCLI="/path/to/tcli.exe"

# Bump version
sed -i "s/versionNumber = \".*\"/versionNumber = \"$VERSION\"/" thunderstore.toml
sed -i "s/version_number\": \".*\"/version_number\": \"$VERSION\"/" manifest.json
sed -i "s/BepInPlugin(\"com.ctogle.procedural_terrain\", \"ProceduralTerrain\", \".*\")/BepInPlugin(\"com.ctogle.procedural_terrain\", \"ProceduralTerrain\", \"$VERSION\")/" ProceduralTerrain/Plugin.cs

echo "Building $VERSION..."
"$DOTNET" build ProceduralTerrain/ProceduralTerrain.csproj -c Release -v quiet

echo "Publishing to Thunderstore..."
"$TCLI" publish --token "$TOKEN"

echo "Done. Tag and push when ready: git tag v$VERSION && git push origin main --tags"
