<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ProceduralTerrain</AssemblyName>
    <RootNamespace>ProceduralTerrain</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <NoWarn>1591;0618</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ValheimManaged + BepInExPath come from Directory.Build.props (gitignored, machine-specific;
       copy Directory.Build.props.example to get started). -->
  <PropertyGroup>
    <VoxheimPath>$(BepInExPath)\plugins\Voxheim-Voxheim</VoxheimPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="1.2.1.0" />
  </ItemGroup>

  <!-- Default configs embedded in the DLL; the plugin writes them to the config dir on first launch. -->
  <ItemGroup>
    <EmbeddedResource Include="..\configs\biomes.cfg" LogicalName="ProceduralTerrain.biomes.cfg" />
    <EmbeddedResource Include="..\configs\placements.cfg" LogicalName="ProceduralTerrain.placements.cfg" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ValheimManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SoftReferenceableAssets">
      <HintPath>$(ValheimManaged)\SoftReferenceableAssets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Voxheim.Core">
      <HintPath>$(VoxheimPath)\Voxheim.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Voxheim">
      <HintPath>$(VoxheimPath)\Voxheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
