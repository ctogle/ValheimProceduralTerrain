#!/bin/bash
# Copy to deploy.sh and fill in your local paths.
set -e
DOTNET="/path/to/dotnet.exe"
SRC_WSL="/path/to/ProceduralTerrain.dll"
DST="/path/to/BepInEx/plugins/ctogle-ProceduralTerrain/ProceduralTerrain.dll"
CSPROJ="/path/to/ProceduralTerrain.csproj"

"$DOTNET" build "$CSPROJ" -c Release

mkdir -p "$(dirname "$DST")"
cp "$SRC_WSL" "$DST"
echo "Done. Relaunch Valheim to load the new DLL."
